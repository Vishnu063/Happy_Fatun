# TEMPLATE ONLY. Fill privately; never commit actual values or apply this example.
apiVersion: v1
kind: Secret
metadata: { name: happy-furn-secrets, namespace: happy-furn-lab }
type: Opaque
stringData:
  DATABASE_URL: '<private PostgreSQL connection URL>'
  POSTGRES_PASSWORD: '<lab password matching DATABASE_URL>'
  OWNER_PASSWORD_HASH: '<PBKDF2 hash generated privately by existing script>'
  SESSION_SECRET: '<at least 32 random characters>'
