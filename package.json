{
  "name": "happy-fatun",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:local": "wrangler d1 migrations apply happy-fatun --local",
    "db:remote": "wrangler d1 migrations apply happy-fatun --remote",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "owner:hash": "node scripts/owner-hash.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brief": "node scripts/github-brief.mjs",
    "deploy:check": "node scripts/deploy.mjs --check",
    "dev:preview": "wrangler dev --local --config wrangler.preview.jsonc --port 8787",
    "preview:check": "node scripts/deploy.mjs --preview --check",
    "preview:dry-run": "npm run build && node scripts/deploy.mjs --preview --dry-run",
    "deploy:preview": "npm run build && node scripts/deploy.mjs --preview",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts",
    "db:preview:local": "wrangler d1 migrations apply happy-fatun --local --config wrangler.preview.jsonc",
    "build:frontend": "npm run build",
    "build:backend": "tsc -p tsconfig.server.json && esbuild server/index.ts server/migrate.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outdir=dist-server --out-extension:.js=.mjs",
    "start:backend": "node dist-server/index.mjs",
    "migrate:postgres": "node dist-server/migrate.mjs --apply",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:compose": "node scripts/test-compose.mjs",
    "test:s3": "node scripts/test-s3.mjs",
    "lab:env": "node scripts/init-lab-env.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@hono/node-server": "^2.1.6",
    "@prometheus-io/client": "^0.16.1",
    "@tailwindcss/vite": "^4.1.0",
    "hono": "^4.10.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "proxy-addr": "^2.0.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.180.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/proxy-addr": "^2.0.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.5",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
